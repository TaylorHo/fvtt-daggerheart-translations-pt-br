    {
      "name": "O Fardo da Vigília",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>É impossível dormir aqui. Quando o grupo descansa, cada personagem pode escolher apenas uma ação de intervalo.</p><section id=\"secret-Pvxn0QyLyH3mwo8K\" class=\"secret\"><p>Que pensamentos mantêm os personagens acordados aqui? Como podem apoiar uns aos outros sem sucumbir ao desespero?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null,
        "actorResources": []
      },
      "_id": "ikYzJk9bR2zcZFZu",
