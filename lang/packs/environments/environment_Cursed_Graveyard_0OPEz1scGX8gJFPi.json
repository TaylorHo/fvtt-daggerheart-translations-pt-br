{
  "type": "environment",
  "name": "Cemitério Amaldiçoado",
  "folder": "GQ0VnOLrKBIHR6Us",
  "system": {
    "type": "exploration",
    "description": "<p>Um vasto cemitério repleto de lápides em ruínas, árvores retorcidas possuídas pelos mortos e criptas tomadas por musgo e hera.</p>",
    "tier": 1,
    "impulses": "Enterrá-los a sete palmos, sufocar com névoa, atrair com promessas de tesouro sepultado, libertar os mortos inquietos",
    "difficulty": 11,
    "attribution": {
      "source": "Daggerheart SRD H&F",
      "page": null
    },
    "potentialAdversaries": {
      "6RB1MDFDZlGQGOXa": {
