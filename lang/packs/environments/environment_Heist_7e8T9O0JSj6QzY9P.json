{
  "type": "environment",
  "name": "Assalto",
  "folder": "XMeecO3IRvu5ck6F",
  "system": {
    "type": "event",
    "description": "<p>O grupo deve obter acesso a um local oculto ou bem protegido para adquirir as informações ou itens guardados nele.</p>",
    "tier": 2,
    "impulses": "Fazer o grupo se preparar, separá-los, erguer obstáculos, prendê-los lá dentro, esgotar seus recursos",
    "difficulty": 14,
    "attribution": {
      "source": "Daggerheart SRD H&F",
      "page": null
    },
    "potentialAdversaries": {
      "gzQzvwR4kNa9okSB": {
        "label": "Adversários",
        "adversaries": [
