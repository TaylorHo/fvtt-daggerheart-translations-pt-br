    },
    {
      "name": "\"Aceita uma Dança?\"",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>Ao dançar, um personagem pode fazer um Teste de Agilidade em vez de um Teste de Presença para influenciar os outros.</p><section id=\"secret-Xi3GbKgbKvxZGUmM\" class=\"secret\"><p>O que há de notável ou singular nas danças em voga por aqui? Onde os personagens aprenderam a executá-las?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null,
        "actorResources": []
      },
      "_id": "AkVcdbmlKOIBAkp6",
