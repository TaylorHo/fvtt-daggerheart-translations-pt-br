      },
      "_key": "!actors.items!E1m1Gw1yQ86QCGuf.PLpqyj4fQgYvSdPb"
    },
    {
      "name": "Multidões Fervilhantes",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>Todos os adversários ganham a característica \"Implacável (2)\": Podem receber o destaque até duas vezes por turno do Mestre. Gaste Medo normalmente para dar o destaque a eles.</p><section id=\"secret-usl2dk9xB2kyjwK4\" class=\"secret\"><p>De onde vem o novo poder desses inimigos? Existe alguma forma de cortá-los dele?</p></section>",
        "attribution": {},
        "gmNotes": "",
        "resource": null,
        "actions": {},
        "granter": null,
        "actorResources": []
      },
      "_id": "ycAtgL8GOU2Igpvz",
