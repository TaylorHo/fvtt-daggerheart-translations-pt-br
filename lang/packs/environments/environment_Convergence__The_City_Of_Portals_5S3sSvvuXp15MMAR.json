    {
      "name": "Rumo ao Multiverso",
      "type": "feature",
      "system": {
        "featureForm": "passive",
        "description": "<p>A cidade de Convergência tem um portal ou porta para cada reino da existência.</p><section id=\"secret-Tu6AYVy5cD2UXJxq\" class=\"secret\"><p>Aonde (ou quando) o grupo quer ir? Onde fica esse portal e quem controla a área?</p></section>",
        "attribution": {},
